Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/MarkerArray
    Name: Estimated partition walls
    Enabled: true
    Topic:
      Value: /partition/wall_markers
      Depth: 1
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
  - Class: rviz_default_plugins/Axes
    Name: Map origin
    Enabled: true
    Reference Frame: partition_odom
    Length: 0.15
    Radius: 0.005
  Global Options:
    Fixed Frame: partition_odom
    Frame Rate: 20
    Background Color: 45; 45; 45
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4.0
      Pitch: 0.65
      Yaw: 0.8
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.0
      Target Frame: partition_map_view
Window Geometry:
  Width: 1100
  Height: 750
