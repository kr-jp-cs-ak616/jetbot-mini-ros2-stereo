+def read_voltage(bus, samples=5, attempts=30):
+    """Median of several valid samples, for one-shot CLI checks."""
+    values = []
+    for _ in range(attempts):
+        try:
+            values.append(bus.voltage())
+        except BatteryReadInvalid:
+            pass
+        if len(values) == samples:
+            return sorted(values)[samples // 2]
+        time.sleep(0.02)
+    raise BatteryReadInvalid('Only %d valid battery samples in %d reads' % (len(values), attempts))
