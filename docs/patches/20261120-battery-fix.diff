+    def _battery_bus(self, raws):
+        bus = object.__new__(I2CBus)
+        bus.reads_since_write = 0
+        bus._read_raw = Mock(side_effect=raws)
+        bus._smbus_write = Mock()
+        return bus
+
+    def test_dropped_high_byte_is_invalid_not_low(self):
+        bus = self._battery_bus([0x366, 0x066])
+        self.assertAlmostEqual(bus.voltage(), 11.31, places=2)
+        with self.assertRaises(BatteryReadInvalid):
+            bus.voltage()  # 1.33 V before the fix
+
+    def test_harmless_write_before_256th_read(self):
+        bus = self._battery_bus([0x33e] * 450)
+        for _ in range(450):
+            bus.voltage()
+        self.assertEqual(bus._smbus_write.call_args_list, [call(6, [0]), call(6, [0])])
+        self.assertLess(bus.reads_since_write, 256)
+
+    def test_battery_monitor_ignores_glitches_but_faults_on_real_low(self):
+        monitor = BatteryMonitor(9.9, low_samples=5, invalid_timeout=10.0)
+        glitch = Mock(side_effect=BatteryReadInvalid('dropped'))
+        self.assertEqual(monitor.update(lambda: 10.8, 0.0), 10.8)
+        for t in range(1, 10):
+            self.assertEqual(monitor.update(glitch, float(t)), 10.8)
+        self.assertEqual(monitor.update(lambda: 10.8, 10.0), 10.8)  # valid sample resets timer
+        for t in range(11, 15):
+            monitor.update(lambda: 9.0, float(t))
+        with self.assertRaisesRegex(RuntimeError, 'missing/low'):
+            monitor.update(lambda: 9.0, 15.0)
+
