+class BatteryMonitor:
+    """Low-voltage fault only on consecutive valid samples; invalid samples time out separately."""
+
+    def __init__(self, minimum, low_samples=5, invalid_timeout=10.0):
+        self.minimum = minimum
+        self.low_samples = low_samples
+        self.invalid_timeout = invalid_timeout
+        self.voltage = None
+        self.low_count = 0
+        self.invalid_since = None
+
+    def update(self, read, now):
+        try:
+            value = read()
+        except BatteryReadInvalid as exc:
+            if self.invalid_since is None:
+                self.invalid_since = now
+            if now - self.invalid_since >= self.invalid_timeout:
+                raise RuntimeError('Motor battery missing or reading invalid for %.1f s: %s'
+                                   % (now - self.invalid_since, exc))
+            return self.voltage
+        self.invalid_since = None
+        self.voltage = value
+        self.low_count = self.low_count + 1 if value < self.minimum else 0
+        if self.low_count >= self.low_samples:
+            raise RuntimeError('Motor battery missing/low: %.2f V (%d consecutive samples)'
+                               % (value, self.low_count))
+        return value
+
